{
  "env": {
    "ENABLE_TOOL_SEARCH": "true",
    "ANTHROPIC_BASE_URL": "http://127.0.0.1:8787"
  },
  "permissions": {
    "allow": [
      "Bash(npx expo-doctor *)",
      "WebFetch(domain:docs.expo.dev)",
      "Bash(node -e \"const p=require\\('./node_modules/expo-router/package.json'\\); console.log\\(JSON.stringify\\(p.exports, null, 2\\)\\)\")",
      "Bash(node -e \"const p=require\\('./node_modules/expo-router/package.json'\\); console.log\\(JSON.stringify\\(p.dependencies,null,2\\)\\)\")",
      "Bash(node *)",
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(npm test *)",
      "Skill(update-config)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/91998/.local/bin/headroom.EXE wrap selfheal --marker headroom-wrap-selfheal",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
