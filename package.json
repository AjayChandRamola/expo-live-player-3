{
  "name": "expo-live-player",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "test": "jest",
    "test:web": "jest -c jest.web.config.js",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "prebuild": "expo prebuild --clean",
    "reset-project": "node ./scripts/reset-project.js",
    "setup": "node ./scripts/setup.js",
    "clean-managed": "powershell -Command \"if (Test-Path 'node_modules') { Remove-Item -Recurse -Force node_modules }; if (Test-Path 'package-lock.json') { Remove-Item -Force package-lock.json }; npm install; npx expo-doctor; npx eslint 'app/**/*.{ts,tsx}' --max-warnings 0; npx expo start\"",
    "managed": "npx expo-doctor && npx eslint \"app/**/*.{ts,tsx}\" --max-warnings 0 && npx expo start"
  },
  "dependencies": {
    "@babel/core": "~7.21.0",
    "@expo-google-fonts/mukta": "^0.2.3",
    "@expo-google-fonts/noto-sans-devanagari": "^0.2.3",
    "@expo-google-fonts/roboto": "^0.4.1",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/slider": "5.0.1",
    "@react-native-masked-view/masked-view": "0.3.2",
    "@react-navigation/native": "^7.1.8",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "ajv": "^8.17.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.0",
    "expo": "54.0.22",
    "expo-asset": "~12.0.9",
    "expo-audio": "~1.0.13",
    "expo-brightness": "~14.0.8",
    "expo-constants": "~18.0.9",
    "expo-file-system": "~19.0.17",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.10",
    "expo-keep-awake": "~15.0.7",
    "expo-linear-gradient": "~15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.14",
    "expo-screen-orientation": "~9.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-video": "~3.0.11",
    "expo-web-browser": "~15.0.8",
    "prettier": "^3.6.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-calendars": "^1.1306.0",
    "react-native-collapsible": "^1.6.2",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-safe-area-context": "5.6.2"
  },
  "devDependencies": {
    "@babel/core": "^7.21.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.38.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.18",
    "npm-force-resolutions": "^0.0.10",
    "react-native-svg-transformer": "^1.5.2",
    "react-test-renderer": "^19.1.0",
    "typescript": "~5.9.2"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "**/__tests__/**/*.test.[jt]s?(x)"
    ],
    "modulePathIgnorePatterns": [
      "/\\.worktrees/"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.worktrees/",
      "\\.web\\.test\\.tsx?$",
      "/docs/history/"
    ],
    "setupFilesAfterEnv": [
      "@testing-library/react-native/build/matchers/extend-expect",
      "<rootDir>/__tests__/harness/setup.ts"
    ],
    "moduleNameMapper": {
      "\\.svg$": "<rootDir>/__mocks__/svgMock.js"
    },
    "collectCoverageFrom": [
      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "services/**/*.{ts,tsx}",
      "contexts/**/*.{ts,tsx}"
    ]
  },
  "private": true
}
